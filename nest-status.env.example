# copy to /etc/nest-status.env, chmod 600
# your router's LAN address (192.168.86.1 is the Google Wifi default)
NEST_ROUTER=192.168.86.1
# New Relic INGEST - LICENSE key (not a user key)
NR_LICENSE_KEY=
# US or EU (match your NR account's data region)
NR_REGION=EU
# optional: shown as 'host' attribute
#NEST_HOST_LABEL=rpi-home
